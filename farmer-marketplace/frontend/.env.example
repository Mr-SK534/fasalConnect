# ============================================================
# Frontend Environment Variables — TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — only this .env.example.
#
# Note: Vite requires all env variables to be prefixed with VITE_
# to be accessible in the frontend code (import.meta.env.VITE_...)
# ============================================================

# --- Backend API ---
VITE_API_BASE_URL=http://localhost:8000

# --- Razorpay (Payments — test mode, safe to expose publicly) ---
# This is the PUBLIC key only — never put RAZORPAY_KEY_SECRET here.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
